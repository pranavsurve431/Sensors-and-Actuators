//
int red = 7;
int green = 6;
int blue = 5;

void setup()
{
  pinMode(12, OUTPUT);
  pinMode(13, INPUT);
  Serial.begin(9600);
  pinMode(red, OUTPUT);
  pinMode(green, OUTPUT);
  pinMode(blue, OUTPUT);
  
}

void loop()
{
  int distance = 0;
  digitalWrite(12, LOW);
  delayMicroseconds(2);
  digitalWrite(12, HIGH);
  delayMicroseconds(10);
  digitalWrite(12, LOW);
  
  long duration = pulseIn(13, HIGH, 30000);
  
  if (duration == 0)
  {
  distance = -1;
  }
  
  else
  {
  distance = duration * 0.034 / 2;
  }
  Serial.println(distance);
  
  if (distance < 89)
  {
    setColor(255,0,0);
  }
  
  else if (distance > 89 && distance < 120)
  {
    setColor(255,255,0);
  }
  
  else
  {
    setColor(0,255,0);
  }
}

void setColor(int red, int green, int blue)
{
analogWrite(7, red);
analogWrite(6, green);
analogWrite(5, blue);
}
